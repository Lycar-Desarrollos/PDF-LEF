{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kova PDF",
  "mainBinaryName": "KovaPDF",
  "version": "2.3.4",
  "identifier": "studio.kova.pdf",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kova PDF",
        "width": 1200,
        "height": 740,
        "minWidth": 840,
        "minHeight": 560,
        "maximized": true,
        "center": true,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": [
      "icons/pdf-document.ico"
    ],
    "publisher": "Kova Studio",
    "shortDescription": "Estudio PDF Nativo 100% Local para Windows",
    "longDescription": "Kova PDF: Estudio profesional de lectura, edicion in-situ, conversion y firma de documentos PDF 100% local para Windows 10 y Windows 11.",
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "KovaPDF.Document",
        "description": "Documento PDF (Kova PDF)",
        "role": "Editor",
        "mimeType": "application/pdf"
      }
    ],
    "windows": {
      "allowDowngrades": true,
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installerHooks": "nsis/hooks.nsh",
        "headerImage": null,
        "installMode": "currentUser",
        "languages": ["Spanish", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
